; Engine configuration file.
; Одноразовая песочница (#12): не архитектура игры и не утверждённый арт. См. sandbox/README.md.

config_version=5

[application]

config/name="The Mender's Tale — песочница"
config/description="Одноразовый макет: две сцены из мокапов для проверки инструментов (#12)."
run/main_scene="res://scenes/counter/counter.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/missing_await=1
gdscript/warnings/narrowing_conversion=2
gdscript/warnings/int_as_enum_without_cast=2

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
